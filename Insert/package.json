{
  "name": "insert",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start --host lan",
    "start:offline": "cross-env EXPO_OFFLINE=1 node node_modules/expo/bin/cli start --host lan",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node node_modules/expo/bin/cli start --android --host lan",
    "ios": "node node_modules/expo/bin/cli start --ios --host lan",
    "web": "node node_modules/expo/bin/cli start --web",
    "lint": "node node_modules/expo/bin/cli lint",
    "test:rules": "firebase emulators:exec --only firestore --project demo-insert \"node --test tests/*.test.js\"",
    "test:deletion": "firebase emulators:exec --only auth,firestore,storage --project demo-insert \"node --test functions/tests/*.test.js\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@firebase/auth": "^1.10.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "^58.0.21",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "firebase": "^11.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
