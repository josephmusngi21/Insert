{
  "expo": {
    "name": "Insert",
    "slug": "Insert",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "insert",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "insert-app",
    "privacy": "public",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.insert.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow Insert to access your local network for communication",
        "NSBonjourServiceTypes": [
          "_http._tcp"
        ],
        "NSMicrophoneUsageDescription": "We don't access your microphone",
        "NSPhotoLibraryUsageDescription": "Allow Insert to access your photo library for sharing food items",
        "NSCameraUsageDescription": "Allow Insert to access your camera to take photos of food items",
        "UIRequiredDeviceCapabilities": [],
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "tabletImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#ffffff"
      },
      "usesCloudStorage": false,
      "usesAppleSignIn": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.insert.app",
      "versionCode": 1,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ],
      "usesPermission": [
        {
          "name": "android.permission.INTERNET"
        },
        {
          "name": "android.permission.CAMERA"
        },
        {
          "name": "android.permission.READ_EXTERNAL_STORAGE"
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "isEnabled": true
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
